# Use the same Firebase web app as Task P4.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Resend: keep the API key secret and on the backend only.
RESEND_API_KEY=re_your_private_resend_key
RESEND_FROM=onboarding@resend.dev
RESEND_OWNER_EMAIL=your_resend_account_email@example.com
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# D1 server-only Firebase Admin service account. Download your project's key
# from Firebase Console > Project settings > Service accounts > Generate new private key.
# Save the key locally as serviceAccountKey.json in the project root. NEVER commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
